@baseUrl = http://localhost:8080
@email = reader.http@example.com
@password = password123
@bookPageLimit = 2
@registerTraceId = 11111111111111111111111111111111
@googleCredential = paste-google-id-token-from-browser-callback-here
@facebookAccessToken = paste-facebook-user-access-token-from-sdk-here
@sellerId = 22222222-2222-4222-8222-222222222222
@fundingKey = fund-reader-http-001
@orderKey = order-reader-http-001
@paymentKey = payment-reader-http-001
@pushDeviceId = 33333333-3333-4333-8333-333333333333
@fcmRegistrationToken = paste-fcm-registration-token-from-browser-here

### 1. Gateway health check
GET {{baseUrl}}/healthz
Accept: application/json

### 2. Register a customer account
# Chay request nay mot lan. Neu email da ton tai, API se tra ve 409.
# @name register
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json
Accept: application/json
X-Trace-ID: {{registerTraceId}}

{
  "email": "{{email}}",
  "password": "{{password}}",
  "display_name": "HTTP Test Reader"
}

### 3. Login
# Response tra access token ngan han. Refresh token nam trong cookie HttpOnly va
# duoc HTTP client luu tu dong; JavaScript khong doc duoc cookie nay.
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### 3.1. Refresh access token and rotate HttpOnly cookie
# @name refresh
POST {{baseUrl}}/api/v1/auth/refresh
Accept: application/json

### 3.1a. Login with Google Identity Services
# credential la Google ID token JWT tra ve trong callback cua GIS, khong phai access token.
# Storefront dung create_account=true; admin portal dung false.
# @name googleProviderState
POST {{baseUrl}}/api/v1/auth/provider-state
Content-Type: application/json
Accept: application/json

{
  "provider": "google",
  "create_account": true
}

### 3.1a.1. Complete Google login
# Google button phai duoc initialize voi nonce va state bang gia tri vua nhan.
POST {{baseUrl}}/api/v1/auth/google
Content-Type: application/json
Accept: application/json

{
  "credential": "{{googleCredential}}",
  "state": "{{googleProviderState.response.body.$.state}}",
  "create_account": true
}

### 3.1b. Login with Facebook JavaScript SDK
# access_token la user access token tra ve trong response.authResponse.accessToken.
# Storefront dung create_account=true; admin portal dung false.
# @name facebookProviderState
POST {{baseUrl}}/api/v1/auth/provider-state
Content-Type: application/json
Accept: application/json

{
  "provider": "facebook",
  "create_account": true
}

### 3.1b.1. Complete Facebook login
POST {{baseUrl}}/api/v1/auth/facebook
Content-Type: application/json
Accept: application/json

{
  "access_token": "{{facebookAccessToken}}",
  "state": "{{facebookProviderState.response.body.$.state}}",
  "create_account": true
}

### 3.2. Logout and revoke current refresh session
# Chay request nay sau cung vi no xoa cookie refresh.
POST {{baseUrl}}/api/v1/auth/logout
Accept: application/json

### 4. Get current profile
# Profile duoc tao bat dong bo qua RabbitMQ. Neu vua register ma gap 404,
# doi 1-2 giay roi chay lai request nay.
GET {{baseUrl}}/api/v1/users/me
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 5. Update current profile
PUT {{baseUrl}}/api/v1/users/me
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "display_name": "HTTP Test Reader Updated"
}

### 6. List books - public API
# Dung limit nho de de nhin thay next_cursor voi du lieu test.
# @name firstBookPage
GET {{baseUrl}}/api/v1/books?limit={{bookPageLimit}}
Accept: application/json

### 6.1. List next book page - run after request 6
# Chi chay request nay khi response 6 co has_more=true va next_cursor.
GET {{baseUrl}}/api/v1/books?limit={{bookPageLimit}}&cursor={{firstBookPage.response.body.$.pagination.next_cursor}}
Accept: application/json

### Admin setup
# Tai khoan moi mac dinh co role customer. Truoc khi chay request 7-10:
# 1. Mo pgAdmin > bookstore > Query Tool.
# 2. Chay SQL:
#    UPDATE auth.accounts
#    SET roles = ARRAY['customer', 'admin']::TEXT[], updated_at = NOW()
#    WHERE email = 'reader.http@example.com';
# 3. Chay lai request "3. Login" de access token moi chua role admin.

### 7. Create a book - admin only
# @name createBook
POST {{baseUrl}}/api/v1/admin/books
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "title": "Clean Architecture3",
  "author": "Robert C. Martin3",
  "isbn": "97801344941613",
  "price_cents": 3993,
  "stock": 13,
  "seller_id": "{{sellerId}}"
}

### 8. Get the created book - public API
GET {{baseUrl}}/api/v1/books/{{createBook.response.body.$.id}}
Accept: application/json

### 9. Update the created book - admin only
PUT {{baseUrl}}/api/v1/admin/books/{{createBook.response.body.$.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "title": "Clean Architecture - Updated",
  "author": "Robert C. Martin",
  "isbn": "9780134494166",
  "price_cents": 4299,
  "stock": 20,
  "seller_id": "{{sellerId}}"
}

### 9.1. Create current-user wallet
POST {{baseUrl}}/api/v1/wallets/me
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 9.2. Fund current-user wallet - admin only
# UpdateBalance tao double-entry ledger, khong overwrite balance truc tiep.
PUT {{baseUrl}}/api/v1/admin/wallets/{{login.response.body.$.user_id}}/balance
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}
Idempotency-Key: {{fundingKey}}

{
  "delta_cents": 1000000,
  "reason": "local HTTP checkout test"
}

### 9.3. Add book to cart
# @name addCartItem
POST {{baseUrl}}/api/v1/cart/items
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "bookId": "{{createBook.response.body.$.id}}",
  "quantity": 2
}

### 9.4. List cart
GET {{baseUrl}}/api/v1/cart/items
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 9.5. Update cart quantity
PUT {{baseUrl}}/api/v1/cart/items/{{addCartItem.response.body.$.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "quantity": 3
}

### 9.6. Create order and reserve stock
# @name createOrder
POST {{baseUrl}}/api/v1/orders
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}
Idempotency-Key: {{orderKey}}

### 9.7. Pay order
# @name createPayment
POST {{baseUrl}}/api/v1/payments
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}
Idempotency-Key: {{paymentKey}}

{
  "orderId": "{{createOrder.response.body.$.id}}"
}

### 9.7.1. Pay another reserved order through VNPAY
# Set vnpayOrderId to a newly created stock-reserved order. Requires
# payment.vnpay.enabled=true and sandbox credentials in config/local.yml.
@vnpayOrderId = 00000000-0000-0000-0000-000000000000
POST {{baseUrl}}/api/v1/payments
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}
Idempotency-Key: vnpay-payment-{{$uuid}}

{
  "orderId": "{{vnpayOrderId}}",
  "provider": "vnpay",
  "locale": "vn"
}

### 9.8. Get order
GET {{baseUrl}}/api/v1/orders/{{createOrder.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 9.9. List orders
GET {{baseUrl}}/api/v1/orders?limit=20
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 9.10. Get payment by ID
GET {{baseUrl}}/api/v1/payments/{{createPayment.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 9.11. Get payment by order ID
GET {{baseUrl}}/api/v1/payments/order/{{createOrder.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 10. Delete the created book - admin only (run after checkout tests)
DELETE {{baseUrl}}/api/v1/admin/books/{{createBook.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 11. List customers - admin only
# @name firstCustomerPage
GET {{baseUrl}}/api/v1/admin/customers?limit=20
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 11.1. List next customer page - run only when has_more=true
GET {{baseUrl}}/api/v1/admin/customers?limit=20&cursor={{firstCustomerPage.response.body.$.pagination.next_cursor}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 12. Get a customer - admin only
GET {{baseUrl}}/api/v1/admin/customers/{{register.response.body.$.user_id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 13. Update a customer profile - admin only
PUT {{baseUrl}}/api/v1/admin/customers/{{register.response.body.$.user_id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "display_name": "Customer managed by admin"
}

### 13.1. Delete a customer - admin only
# API tra 202 khi account va outbox event da commit. User profile se duoc worker
# xoa bat dong bo qua RabbitMQ. Khong dung ID cua chinh admin dang dang nhap.
DELETE {{baseUrl}}/api/v1/admin/customers/{{register.response.body.$.user_id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 14. Swagger JSON
GET {{baseUrl}}/swagger/doc.json
Accept: application/json

### 15. List my notifications
# @name firstNotificationPage
GET {{baseUrl}}/api/v1/notifications?limit=20
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 15.1. Get unread notification count
GET {{baseUrl}}/api/v1/notifications/unread-count
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 15.2. Mark one notification read
# Run only when request 15 returned at least one notification.
PUT {{baseUrl}}/api/v1/notifications/{{firstNotificationPage.response.body.$.data[0].id}}/read
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 15.3. Mark all notifications read
PUT {{baseUrl}}/api/v1/notifications/read-all
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 15.4. Register or refresh a Web Push installation
POST {{baseUrl}}/api/v1/notifications/devices
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "device_id": "{{pushDeviceId}}",
  "registration_token": "{{fcmRegistrationToken}}",
  "application": "storefront",
  "platform": "web"
}

### 15.5. Unregister the Web Push installation
DELETE {{baseUrl}}/api/v1/notifications/devices/{{pushDeviceId}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 16. Create a root comment
# @name createComment
POST {{baseUrl}}/api/v1/books/{{createBook.response.body.$.id}}/comments
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "content": "Cuốn sách rất dễ đọc và thực tế."
}

### 16.1. Reply to the root comment
# @name createReply
POST {{baseUrl}}/api/v1/books/{{createBook.response.body.$.id}}/comments
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "content": "Mình cũng có cùng cảm nhận.",
  "parent_id": "{{createComment.response.body.$.id}}"
}

### 16.2. List root comments
GET {{baseUrl}}/api/v1/books/{{createBook.response.body.$.id}}/comments?limit=20
Accept: application/json

### 16.3. List all replies in the thread
GET {{baseUrl}}/api/v1/comments/{{createComment.response.body.$.id}}/replies?limit=50
Accept: application/json

### 16.4. Update own reply
PUT {{baseUrl}}/api/v1/comments/{{createReply.response.body.$.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "content": "Mình cũng có cùng cảm nhận, đặc biệt là chương cuối."
}

### 16.5. Soft-delete own reply
DELETE {{baseUrl}}/api/v1/comments/{{createReply.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 16.6. Hide comment - admin only
PUT {{baseUrl}}/api/v1/admin/comments/{{createComment.response.body.$.id}}/status
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "status": "hidden"
}

### 17. Open or get my support conversation
# @name supportConversation
POST {{baseUrl}}/api/v1/chat/conversations/support
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 17.1. List accessible conversations
GET {{baseUrl}}/api/v1/chat/conversations?limit=20
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 17.2. Send an idempotent chat message
# @name supportMessage
POST {{baseUrl}}/api/v1/chat/conversations/{{supportConversation.response.body.$.id}}/messages
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}
Idempotency-Key: {{$uuid}}

{
  "content": "Xin chào, mình cần hỗ trợ về đơn hàng."
}

### 17.3. List latest messages
GET {{baseUrl}}/api/v1/chat/conversations/{{supportConversation.response.body.$.id}}/messages?limit=30
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 17.4. Mark conversation read through the latest sequence
PUT {{baseUrl}}/api/v1/chat/conversations/{{supportConversation.response.body.$.id}}/read
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "sequence_number": 0
}

### 17.5. Get unread chat count
GET {{baseUrl}}/api/v1/chat/unread-count
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 17.6. Issue one-time WebSocket ticket
# Use the returned ticket immediately at:
# ws://localhost:8080/api/v1/chat/ws?ticket=<ticket>
POST {{baseUrl}}/api/v1/chat/ws-ticket
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 17.7. Update own chat message
PUT {{baseUrl}}/api/v1/chat/messages/{{supportMessage.response.body.$.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "content": "Xin chào, mình cần hỗ trợ kiểm tra đơn hàng."
}

### 17.8. Soft-delete own chat message
DELETE {{baseUrl}}/api/v1/chat/messages/{{supportMessage.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

### 18. GraphQL book detail - public aggregation
POST {{baseUrl}}/graphql
Content-Type: application/json
Accept: application/json

{
  "query": "query BookDetail($id: ID!) { bookDetail(id: $id, commentsFirst: 20) { book { id title author isbn priceCents stock } comments { nodes { id authorName content replyCount } pageInfo { hasNextPage endCursor } } } }",
  "variables": {
    "id": "{{createBook.response.body.$.id}}"
  }
}

### 18.1. GraphQL admin dashboard
POST {{baseUrl}}/graphql
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "query": "query AdminDashboard { adminDashboard(booksFirst: 30, customersFirst: 5) { catalog { loadedCount inventoryUnits lowStockCount inventoryValueCents recentBooks { id title stock } lowStockBooks { id title stock } pageInfo { hasNextPage endCursor } } customers { loadedCount recentCustomers { id email displayName } pageInfo { hasNextPage endCursor } } } }"
}

### 18.2. GraphQL current-user order detail
POST {{baseUrl}}/graphql
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.access_token}}

{
  "query": "query OrderDetail($id: ID!) { orderDetail(id: $id) { order { id status totalCents currency items { id bookId title quantity subtotalCents } } payment { id status amountCents provider paidAt } } }",
  "variables": {
    "id": "{{createOrder.response.body.$.id}}"
  }
}
