# Copy to alertmanager.local.yml (gitignored). Replace channel/chat_id.
# Store actual webhook/token in backend/secrets/alertmanager/ files.
global:
  resolve_timeout: 5m
route:
  receiver: slack-and-telegram
  group_by: [alertname, job, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: slack-and-telegram
    slack_configs:
      - api_url_file: /etc/alertmanager/secrets/slack-webhook
        channel: "#bookstore-alerts"
        send_resolved: true
        title: '[{{ .Status | toUpper }}] Book Store: {{ .CommonLabels.alertname }}'
        text: '{{ range .Alerts }}{{ .Annotations.summary }} — {{ .Annotations.description }}{{ "\n" }}{{ end }}'
    telegram_configs:
      - bot_token_file: /etc/alertmanager/secrets/telegram-bot-token
        # Replace with your numeric chat ID (groups usually use a negative ID).
        chat_id: -1000000000000
        parse_mode: ""
        send_resolved: true
        message: '[{{ .Status | toUpper }}] Book Store {{ .CommonLabels.alertname }}: {{ range .Alerts }}{{ .Annotations.summary }} — {{ .Annotations.description }}{{ "\n" }}{{ end }}'
