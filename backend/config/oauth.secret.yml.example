# Copy these sections into your gitignored config/local.secret.yml.
# Auth Service must start with -secrets config/local.secret.yml.
auth:
  discord:
    client_id: ""
    client_secret: ""
    redirect_uris:
      - "http://localhost:5173/auth/callback/discord"
      - "http://localhost:5174/auth/callback/discord"
  twitter:
    client_id: ""
    client_secret: ""
    redirect_uris:
      - "http://localhost:5173/auth/callback/twitter"
      - "http://localhost:5174/auth/callback/twitter"
